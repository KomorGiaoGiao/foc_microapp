page {
  width: 100%;
  height: 100%;
  background: #0d0e10;
  color: #f5f5f5;
  font-family: -apple-system, "SF UI Text", "Helvetica Neue", Arial, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.screen {
  position: relative;
  display: block;
  width: 100%;
  height: 100%;
  background: #0d0e10;
}

.search-panel {
  position: absolute;
  left: 12px;
  right: 12px;
  bottom: 72px;
  z-index: 997;
  display: flex;
  align-items: center;
  padding: 8px 12px;
  background: rgba(29, 30, 32, .74);
  border-bottom: 1px solid rgba(255, 255, 255, .1);
  border-radius: 14px;
  backdrop-filter: blur(18px);
  border: 1px solid rgba(255, 255, 255, .12);
  backdrop-filter: blur(18px);
}

.search-input {
  height: 34px;
  padding: 0 10px;
  border: 1px solid rgba(255, 255, 255, .18);
  border-radius: 8px;
  background: rgba(0, 0, 0, .2);
  color: #f5f5f5;
  font-size: 13px;
  flex: 1;
}

.search-action,
.detail-close {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 34px;
  margin-left: 8px;
  padding: 0 12px;
  border: 1px solid rgba(255, 255, 255, .56);
  border-radius: 8px;
  background: rgba(255, 255, 255, .06);
  color: #f5f5f5;
  font-size: 12px;
}

.globe-canvas {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.detail-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 64px;
  z-index: 998;
  padding: 14px 16px 16px;
  background: rgba(29, 30, 32, .78);
  border-top: 1px solid rgba(255, 255, 255, .12);
  border-radius: 14px 14px 0 0;
  backdrop-filter: blur(18px);
}

.detail-kicker {
  color: #f5f5f5;
  font-size: 10px;
  letter-spacing: 1.4px;
}

.detail-title {
  display: block;
  margin-top: 6px;
  color: #f5f5f5;
  font-size: 20px;
  line-height: 1.25;
}

.detail-description {
  display: block;
  margin-top: 4px;
  color: rgba(245, 245, 245, .6);
  font-size: 13px;
  line-height: 1.5;
}

.detail-meta {
  display: flex;
  gap: 18px;
  margin-top: 11px;
  padding-top: 9px;
  border-top: 1px solid rgba(255, 255, 255, .1);
  color: rgba(245, 245, 245, .5);
  font-size: 11px;
}

.detail-close {
  width: 112px;
  margin: 13px 0 0;
}

.legend-panel {
  position: absolute;
  left: 50%;
  bottom: 72px;
  z-index: 997;
  width: 190px;
  padding: 14px;
  transform: translateX(-50%);
  background: rgba(29, 30, 32, .82);
  border: 1px solid rgba(255, 255, 255, .14);
  border-radius: 14px;
  color: #f5f5f5;
  backdrop-filter: blur(18px);
}

.legend-title {
  margin-bottom: 10px;
  color: rgba(245, 245, 245, .58);
  font-size: 11px;
}

.legend-row {
  display: flex;
  align-items: center;
  height: 28px;
  color: rgba(245, 245, 245, .78);
  font-size: 12px;
}

.legend-dot {
  display: inline-block;
  width: 8px;
  height: 8px;
  margin-right: 8px;
  border-radius: 50%;
  background: #f5f5f5;
}

.legend-dot.muted {
  background: #a6a9ad;
}

.zoom-tools {
  position: absolute;
  right: 14px;
  bottom: 86px;
  z-index: 996;
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.zoom-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border: 1px solid rgba(255, 255, 255, .16);
  border-radius: 10px;
  background: rgba(29, 30, 32, .7);
  color: #f5f5f5;
  font-size: 22px;
  line-height: 1;
  backdrop-filter: blur(14px);
}

.bottom-bar {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  width: 100%;
  display: flex;
  justify-content: center;
  height: 64px;
  padding: 6px 12px;
  background: rgba(29, 30, 32, .76);
  border-top: 1px solid rgba(255, 255, 255, .1);
  border-radius: 14px 14px 0 0;
  backdrop-filter: blur(18px);
  overflow: hidden;
}

.bottom-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 76px;
  color: rgba(245, 245, 245, .68);
  border-radius: 8px;
  font-size: 11px;
  line-height: 1.2;
}

.bottom-icon {
  height: 25px;
  color: #f5f5f5;
  font-size: 22px;
  line-height: 22px;
}
