page {
  width: 100%;
  height: 100%;
  background: #111416;
  color: #f4f4f1;
  font-family: -apple-system, "SF UI Text", "Helvetica Neue", Arial, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.screen {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100%;
  background: #111416;
}

.topbar {
  display: flex;
  align-items: center;
  height: 56px;
  padding: 0 14px;
  background: rgba(28, 31, 33, .98);
  border-bottom: 1px solid rgba(255, 255, 255, .1);
  flex-shrink: 0;
}

.brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  border: 1px solid #d8ad5b;
  color: #d8ad5b;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 1px;
  flex-shrink: 0;
}

.brand-copy {
  display: flex;
  flex-direction: column;
  margin-left: 10px;
}

.brand-kicker {
  color: #d8ad5b;
  font-size: 8px;
  letter-spacing: 1.4px;
  line-height: 1.2;
}

.brand-title {
  margin-top: 2px;
  color: #f4f4f1;
  font-size: 14px;
  line-height: 1.2;
}

.top-actions {
  display: flex;
  margin-left: auto;
}

.top-action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38px;
  height: 38px;
  margin-left: 5px;
  color: rgba(244, 244, 241, .78);
  font-size: 23px;
  line-height: 1;
}

.search-panel {
  display: flex;
  align-items: center;
  padding: 8px 12px;
  background: #1c1f21;
  border-bottom: 1px solid rgba(255, 255, 255, .1);
  flex-shrink: 0;
}

.search-input {
  height: 34px;
  padding: 0 10px;
  border: 1px solid rgba(255, 255, 255, .16);
  background: rgba(0, 0, 0, .18);
  color: #f4f4f1;
  font-size: 13px;
  flex: 1;
}

.search-action,
.detail-close {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 34px;
  margin-left: 8px;
  padding: 0 12px;
  border: 1px solid rgba(216, 173, 91, .65);
  color: #d8ad5b;
  font-size: 12px;
}

.map-frame {
  position: relative;
  min-height: 0;
  flex: 1;
}

web-view {
  width: 100%;
  height: 100%;
}

.detail-panel {
  padding: 14px 16px 16px;
  background: rgba(27, 30, 32, .98);
  border-top: 1px solid rgba(255, 255, 255, .12);
  flex-shrink: 0;
}

.detail-kicker {
  color: #d8ad5b;
  font-size: 10px;
  letter-spacing: 1.4px;
}

.detail-title {
  display: block;
  margin-top: 6px;
  color: #f4f4f1;
  font-size: 20px;
  line-height: 1.25;
}

.detail-description {
  display: block;
  margin-top: 4px;
  color: rgba(244, 244, 241, .6);
  font-size: 13px;
  line-height: 1.5;
}

.detail-meta {
  display: flex;
  gap: 18px;
  margin-top: 11px;
  padding-top: 9px;
  border-top: 1px solid rgba(255, 255, 255, .1);
  color: rgba(244, 244, 241, .5);
  font-size: 11px;
}

.detail-close {
  width: 112px;
  margin: 13px 0 0;
}
