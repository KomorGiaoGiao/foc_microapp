<view class="screen">
  <canvas
    id="globe-canvas"
    canvas-id="globe-canvas"
    class="globe-canvas"
    bindtouchstart="handleTouchStart"
    bindtouchmove="handleTouchMove"
    bindtouchend="handleTouchEnd"
    bindtouchcancel="handleTouchEnd"
  ></canvas>

  <view class="search-panel" tt:if="{{searchOpen}}">
    <input class="search-input" value="{{searchQuery}}" bindinput="handleSearchInput" confirm-type="search" placeholder="搜索城市或国家" />
    <view class="search-action" bindtap="submitSearch">定位</view>
  </view>

  <view class="detail-panel" tt:if="{{detailOpen}}">
    <text class="detail-kicker">SELECTED REGION</text>
    <text class="detail-title">{{selectedName}}</text>
    <text class="detail-description">{{selectedDescription}}</text>
    <view class="detail-meta">
      <text>地图数据</text>
      <text>知识库同步</text>
    </view>
    <view class="detail-close" bindtap="closeDetail">返回全球视角</view>
  </view>

  <view class="legend-panel" tt:if="{{legendOpen}}">
    <text class="legend-title">图例</text>
    <view class="legend-row"><view class="legend-dot"></view><text>家族办公室城市</text></view>
    <view class="legend-row"><view class="legend-dot muted"></view><text>当前选中位置</text></view>
  </view>

  <view class="zoom-tools">
    <view class="zoom-button" bindtap="zoomIn">+</view>
    <view class="zoom-button" bindtap="zoomOut">−</view>
  </view>

  <view class="bottom-bar">
    <view class="bottom-action" bindtap="resetView">
      <view class="bottom-icon icon-globe">
        <view class="icon-globe-lat"></view>
        <view class="icon-globe-lng"></view>
      </view>
      <text>全球</text>
    </view>
    <view class="bottom-action" bindtap="toggleSearch">
      <view class="bottom-icon icon-search">
        <view class="icon-search-circle"></view>
        <view class="icon-search-handle"></view>
      </view>
      <text>搜索</text>
    </view>
    <view class="bottom-action" bindtap="toggleLegend">
      <view class="bottom-icon icon-legend">
        <view class="icon-legend-line line-one"></view>
        <view class="icon-legend-line line-two"></view>
        <view class="icon-legend-line line-three"></view>
      </view>
      <text>图例</text>
    </view>
    <view class="bottom-action" bindtap="showMapInfo">
      <view class="bottom-icon icon-info"><text class="icon-info-i">i</text></view>
      <text>说明</text>
    </view>
  </view>
</view>
