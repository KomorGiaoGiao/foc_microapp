<view class="screen">
  <view class="map-frame">
    <web-view id="map-webview" src="{{mapUrl}}" bindmessage="handleWebMessage"></web-view>
  </view>

  <view class="search-panel" tt:if="{{searchOpen}}">
    <input class="search-input" value="{{searchQuery}}" bindinput="handleSearchInput" confirm-type="search" placeholder="搜索城市或国家" />
    <view class="search-action" bindtap="submitSearch">定位</view>
  </view>

  <view class="detail-panel" tt:if="{{detailOpen}}">
    <view class="detail-kicker">SELECTED REGION</view>
    <text class="detail-title">{{selectedName}}</text>
    <text class="detail-description">{{selectedDescription}}</text>
    <view class="detail-meta">
      <text>地图数据</text>
      <text>知识库同步</text>
    </view>
    <view class="detail-close" bindtap="closeDetail">返回全球视角</view>
  </view>

  <cover-view class="bottom-bar">
    <cover-view class="bottom-action" bindtap="toggleSearch">
      <cover-view class="bottom-icon">⌕</cover-view>
      <cover-view>搜索</cover-view>
    </cover-view>
    <cover-view class="bottom-action" bindtap="resetView">
      <cover-view class="bottom-icon">◎</cover-view>
      <cover-view>复位</cover-view>
    </cover-view>
    <cover-view class="bottom-action" bindtap="showMapInfo">
      <cover-view class="bottom-icon">ⓘ</cover-view>
      <cover-view>说明</cover-view>
    </cover-view>
  </cover-view>
</view>
